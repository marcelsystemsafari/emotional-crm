# Vorlage für die Schlüsseldatei einer Lehrerin.
# Kopieren nach .env.<kürzel>.local (z. B. .env.yogini-nina.local) und ausfüllen. Nie weitergeben, nie in Git.

# Zugang zur Flenski-Schnittstelle (Entscheidung 0008): aus einer eingeloggten Flenski-Sitzung im Browser.
# FLENSKI_AUTH: F12 → Netzwerk → Anfrage an api/v1 → Header "authorization: Bearer …" (nur den Teil nach Bearer)
# FLENSKI_REFRESH: F12 → Anwendung/Application → Cookies → "refreshToken"
FLENSKI_AUTH=
FLENSKI_REFRESH=
# Alter Weg, wirkt nur bei öffentlichen Apps:
FLENSKI_API_KEY=

# Signaturschlüssel, einer pro Flenski-Automation (beim Anlegen der Automation angezeigt)
FLENSKI_SECRET_NEUES_MITGLIED=
FLENSKI_SECRET_NEUER_KONTAKT=
FLENSKI_SECRET_PLAN_ZUGEWIESEN=
FLENSKI_SECRET_PLAN_ENTZOGEN=
FLENSKI_SECRET_MITGLIED_GELOESCHT=
FLENSKI_SECRET_BESTELLUNG_ABGESCHLOSSEN=
FLENSKI_SECRET_ZAHLUNG_FEHLGESCHLAGEN=
FLENSKI_SECRET_ABONNEMENT_GEKUENDIGT=
FLENSKI_SECRET_AM_EVENT_TEILGENOMMEN=
FLENSKI_SECRET_EVENT_BEGINNT_BALD=
FLENSKI_SECRET_ZUM_KURS_ANGEMELDET=
FLENSKI_SECRET_KURS_ABGESCHLOSSEN=
FLENSKI_SECRET_BEITRAG_GRUPPE_ERSTELLT=
FLENSKI_SECRET_KOMMENTAR_ERSTELLT=
FLENSKI_SECRET_DATEI_HERUNTERGELADEN=
FLENSKI_SECRET_ARTIKEL_GELESEN=
FLENSKI_SECRET_SPERRBILDSCHIRM_CTA_GEKLICKT=
