# Kopieren nach .env.local und ausfüllen. .env.local NIE weitergeben oder hochladen.
# Werte findest du in Supabase unter: Project Settings → API

# Öffentlich (darf auch in ui/crm.html stehen)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GEHEIM – nur für Claude Code / Supabase CLI auf deinem Rechner, nie in ui/crm.html
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Persönlicher Zugangsschlüssel für die Supabase-CLI (supabase.com/dashboard/account/tokens).
# Ersetzt "supabase login", das auf Marcels Rechner an Norton scheitert.
SUPABASE_ACCESS_TOKEN=
# Datenbank-Passwort (Supabase → Project Settings → Database). Nur in .env.local.
SUPABASE_DB_PASSWORD=

# Flenski-Signaturschlüssel: einer pro Automation, z. B. FLENSKI_SECRET_ARTIKEL_GELESEN=. Nur in .env.local.
FLENSKI_SECRET_NEUES_MITGLIED=
